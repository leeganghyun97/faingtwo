# Copy this file to .env and edit local paths. Never commit .env.
GENIESIM_REPO_ROOT=/absolute/path/to/genie_sim
GENIESIM_DATA_ROOT=/absolute/path/to/geniesim-data
GENIESIM_OUTPUT_ROOT=/absolute/path/to/geniesim-output
GENIESIM_ISAAC_PYTHON=/absolute/path/to/isaac-sim/python
GENIESIM_ASSET_ROOT=/absolute/path/to/GenieSimAssets

# Stage-1A external authorities. Paths are verified against
# configs/reproducibility/external_assets.json before a live run.
GENIESIM_CANDIDATE_A_USD=/absolute/path/to/robot_fix.usda
GENIESIM_GRU_CHECKPOINT=/absolute/path/to/BEST_HUMAN_GRASP_GRU_BC.pt
GENIESIM_FROZEN_STUDENT_CHECKPOINT=/absolute/path/to/CONDITIONAL_CORAL_FROZEN_STUDENT.pt
GENIESIM_FAR_REACH_BC_CHECKPOINT=/absolute/path/to/far_reach_bc_best.pt
GENIESIM_RESIDUAL_ACTOR_CHECKPOINT=/absolute/path/to/stage1a_residual_actor.pt

# Optional experiment tracking. Store the API key through `wandb login` or a
# local secret manager; do not place WANDB_API_KEY in this file for sharing.
WANDB_ENTITY=
WANDB_PROJECT=geniesim-stage1a
WANDB_MODE=offline

# Real robot commands remain disabled unless both the relevant script flag and
# this explicit local acknowledgement are set.
GENIESIM_ALLOW_REAL_ROBOT=0
